{
  "appId": "com.davediver.tasks",
  "productName": "🐮🐴的打工日志",
  "icon": "public/icon.png",
  "directories": {
    "output": "release-out"
  },
  "compression": "normal",
  "asar": false,
  "files": [
    "dist/**/*",
    "electron/dist/**/*",
    "package.json",
    "!node_modules",
    "!node_modules/**/*",
    "!android",
    "!android/**/*",
    "!ios",
    "!deploy",
    "!deploy/**/*",
    "!server",
    "!server/**/*",
    "!scripts",
    "!scripts/**/*",
    "!release-out",
    "!release-out/**/*",
    "!release",
    "!release/**/*"
  ],
  "win": {
    "target": [
      { "target": "dir", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ],
    "artifactName": "🐮🐴的打工日志-${version}.${ext}"
  },
  "mac": {
    "target": [],
    "identity": null
  },
  "linux": {
    "target": []
  }
}
