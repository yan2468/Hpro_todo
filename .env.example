# 前端：后端 API 地址
# 本地开发：http://localhost:8787
# 部署到阿里云后：填你的公网地址，例如 https://api.your-domain.com
VITE_API_BASE=http://localhost:8787

# 后端：阿里云 PostgreSQL 连接串
# 格式：postgres://用户名:密码@主机:5432/数据库名
DATABASE_URL=postgres://dave:your_password@your-aliyun-host:5432/davediver

# 后端 JWT 密钥（务必改成随机长字符串）
JWT_SECRET=change-this-to-a-long-random-secret

# 后端监听端口
PORT=8787

# 跨域白名单（JSON 数组格式）。前端从哪个地址访问后端，就填哪些。
# 不填则允许所有来源。示例：
CORS_ORIGINS=["https://www.hbywqx.top","http://8.163.32.86","http://localhost:8000"]
