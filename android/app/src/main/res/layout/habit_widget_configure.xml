<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f7f7f5">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="选择要显示的习惯"
        android:textColor="#21362c"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:text="小组件将展示该习惯的今日打卡状态"
        android:textColor="#5d736a"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/configure_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/configure_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:text="暂无习惯"
        android:textColor="#5d736a"
        android:textSize="15sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/configure_list"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        android:visibility="gone" />

    <!-- 样式设置区域（选择习惯后显示） -->
    <LinearLayout
        android:id="@+id/configure_style_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="12dp">

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#e0d8c8" android:layout_marginBottom="12dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🎨 小组件样式" android:textColor="#21362c"
            android:textSize="16sp" android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="形状"
            android:textColor="#5d736a" android:textSize="13sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:orientation="horizontal">
            <Button android:id="@+id/btn_shape_circle" android:layout_width="0dp"
                android:layout_height="40dp" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:text="⬤ 圆形" android:textSize="13sp" />
            <Button android:id="@+id/btn_shape_rounded" android:layout_width="0dp"
                android:layout_height="40dp" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:text="▢ 圆角" android:textSize="13sp" />
            <Button android:id="@+id/btn_shape_square" android:layout_width="0dp"
                android:layout_height="40dp" android:layout_weight="1"
                android:text="⬜ 方形" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/corner_section" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/corner_label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="圆角大小：16dp"
                android:textColor="#5d736a" android:textSize="13sp" />
            <SeekBar android:id="@+id/corner_seekbar" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:max="50" android:progress="16" />
        </LinearLayout>

        <Button android:id="@+id/btn_pick_bg" android:layout_width="match_parent"
            android:layout_height="42dp" android:layout_marginTop="12dp"
            android:text="📷 选择背景照片" android:textSize="13sp" />
        <TextView android:id="@+id/bg_status" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="" android:textColor="#5d736a" android:textSize="12sp" />

        <Button android:id="@+id/btn_confirm" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="16dp"
            android:background="#34a06a" android:text="✓ 确认添加"
            android:textColor="#ffffff" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
</ScrollView>
