{
  "name": "dave-diver-tasks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/dist/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "server": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "build:electron": "vite build && tsc -p electron/tsconfig.json && cp electron/dist/main.js electron/dist/main.cjs && cp electron/dist/preload.js electron/dist/preload.cjs && electron-builder --config electron/electron-builder.json",
    "cap:init": "cap init dave-diver-tasks com.davediver.tasks --web-dir dist",
    "cap:add": "cap add android",
    "cap:sync": "vite build && cap sync android",
    "apk:debug": "scripts\\build-apk-debug.cmd"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/local-notifications": "^6.1.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
